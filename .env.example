# Rootward local development environment.
#
#   cp .env.example .env
#
# `pnpm dev` and `pnpm dev:status` load this file (repo root) before starting the
# web app and the Supabase stack. `.env` is gitignored; this template is not.
#
# `supabase start` prints the local keys once; `supabase status -o env` reprints
# them any time. That output names them ANON_KEY / SERVICE_ROLE_KEY — copy those
# two values into NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY below.
#

# --- Supabase local stack -----------------------------------------------------
# Ports are the Rootward block: the Supabase defaults (543xx) shifted +3000 so
# this stack never collides with another project's local stack. See
# supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:57322/postgres

# --- Web app -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Admin bootstrap (issue #17) -------------------------------------------
# On sign-in, the account whose email matches this is promoted to active admin
# (/auth/callback does it with the service role). The literal placeholder below
# is ignored — set a real address to bootstrap the first admin.
ADMIN_EMAIL=you@example.com

# --- Google OAuth (issue #17) ---------------------------------------------
# Leave blank for magic-link-only local dev — the stack still starts, the
# "Continue with Google" button just fails until both values are set. Changing
# them needs `supabase stop && supabase start` to reload config.toml.
#
# Deploy note: sign-in returns to <origin>/auth/callback. Every real origin must
# be added to `additional_redirect_urls` in supabase/config.toml (exact match) —
# the committed list only covers localhost.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Optional --------------------------------------------------------------
# Enables the Supabase AI assistant inside local Studio.
OPENAI_API_KEY=
