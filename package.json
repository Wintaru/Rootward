{
  "name": "rootward",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source, self-hostable family-tree website.",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:status": "node --env-file-if-exists=.env scripts/dev-status.mjs",
    "dev:fresh": "node --env-file-if-exists=.env scripts/dev-fresh.mjs",
    "dev:up": "node --env-file-if-exists=.env scripts/dev-fresh.mjs --keep-data",
    "dev:stop": "supabase stop",
    "dev:reset": "supabase db reset",
    "demo:gen": "node scripts/demo-tree/generate.mjs",
    "demo:build": "node scripts/demo-tree/generate.mjs && node scripts/demo-tree/build-gedzip.mjs",
    "gen:types": "npx -y supabase@2.116.0 gen types typescript --local --schema public > apps/web/lib/db/database.types.ts",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @rootward/e2e test:e2e",
    "test:e2e:settings": "pnpm --filter @rootward/e2e test:e2e:settings",
    "test:e2e:report": "pnpm --filter @rootward/e2e test:e2e:report",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "fflate": "^0.8.3",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
