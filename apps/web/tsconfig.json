{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@rootward/gedcom": ["../../packages/gedcom/src/index.ts"],
      "@rootward/media": ["../../packages/media/src/index.ts"],
      "@rootward/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    // `@rootward/media`'s ambient module declarations for `heic-decode` /
    // `piexifjs` (neither ships types) -- not picked up automatically since
    // it lives outside this tsconfig's own directory tree, but its module
    // graph is still part of this program (path-mapped in `paths` above).
    "../../packages/media/src/global.d.ts"
  ],
  "exclude": ["node_modules"]
}
